# Database Configuration
DATABASE_URL=postgresql+asyncpg://bib_user:bib_password@db:5432/brand_intel_db
# For SQLite local dev: sqlite+aiosqlite:///./data/brand_intel.db

# TrustLens-AI Service Configuration
TRUSTLENS_BASE_URL=http://trustlens_service:8001
TRUSTLENS_TIMEOUT_SECONDS=30.0

# Antigravity Platform Integration
ANTIGRAVITY_BASE_URL=https://antigravity.example.com
ANTIGRAVITY_API_KEY=ag_sec_key_demo123456789
RISK_THRESHOLD_FOR_ANTIGRAVITY=70

# openSquat Brand Monitoring List (JSON array or comma-separated strings)
BRAND_LIST=["google", "microsoft", "paypal", "apple", "netflix"]

# Scheduler Configuration (Cron format or interval)
OPENSQUAT_CRON_SCHEDULE=0 0 * * *
AUTO_TRIGGER_ANALYSIS=true

# Data Storage Directory
DATA_DIR=./data
